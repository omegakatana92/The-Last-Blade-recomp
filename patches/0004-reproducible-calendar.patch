+/* Fixed calendar for reproducible runs.  The real uPD4990A keeps the
+ * current date, and a game may seed its RNG from it, so two runs a second
+ * apart can diverge.  --rtc pins the date without changing the default:
+ * with no option the host's local time is used, as on hardware. */
+static int      s_rtc_fixed;
+static uint64_t s_rtc_fixed_reg;

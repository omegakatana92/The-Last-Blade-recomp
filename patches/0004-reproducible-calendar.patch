+void io_set_rtc_fixed(int year, int mon, int mday, int hour, int min, int sec) {
+    static const int t[] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
+    int y = year, m = mon;
+    if (m < 3) y -= 1;
+    int wday = (y + y / 4 - y / 100 + y / 400 + t[(m - 1) & 15] + mday) % 7;
+    if (wday < 0) wday += 7;
+    s_rtc_fixed_reg = (uint64_t)bcd(sec) | ((uint64_t)bcd(min) << 8) |
+                      ((uint64_t)bcd(hour) << 16) | ((uint64_t)bcd(mday) << 24) |
+                      ((uint64_t)(wday & 0xF) << 32) | ((uint64_t)(mon & 0xF) << 36) |
+                      ((uint64_t)bcd(year % 100) << 40);
+    s_rtc_fixed = 1;
+}

--- a/include/neogeorecomp/bus.h
+++ b/include/neogeorecomp/bus.h
@@ -90,6 +90,24 @@ uint8_t *bus_backup_ram(void);      /* 64 KB MVS backup RAM */
 void bus_select_bios_vectors(int bios);
 void bus_set_backup_lock(int locked);
 
+/* Current P-ROM bank: the byte offset of the 1 MB window inside the banked
+ * image.  0 is the first banked megabyte, which is what the recompiler
+ * analyses.  Other banks must run in the interpreter, because a native
+ * entry is tied to the bytes of one bank, not to the window address. */
+uint32_t bus_bank_offset(void);
+
+/* ---- watchdog ----
+ * A write with the low address bit set in $300000-$3BFFFF strokes the
+ * watchdog; if it is not stroked again within 3,244,030 master clocks
+ * (1,622,015 68000 clocks) the board resets.  Several carts use that reset
+ * as part of their first-boot backup-RAM initialisation: they clear the
+ * SRAM, then idle until the watchdog restarts the machine with valid RAM.
+ * bus_watchdog_expired() is polled by the frame scheduler. */
+#define NG_WATCHDOG_CLOCKS 1622015
+void bus_watchdog_kick(void);
+void bus_watchdog_disable(void);
+int  bus_watchdog_expired(void);
+
 #ifdef __cplusplus
 }
 #endif
